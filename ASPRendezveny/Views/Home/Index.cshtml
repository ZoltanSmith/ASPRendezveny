@model List<Rendezveny>
@{
    ViewData["Title"] = "Rendezvény lista";
}

@if (!String.IsNullOrWhiteSpace((String?)TempData["message"]))
{
    <script>
        alert('@TempData["message"]');
    </script>
}

<div class="text-center">
    <ul>
    @foreach (var item in Model)
    {
            <li>
                <a class="btn" asp-controller="Home" asp-action="RendezvenySzerk" asp-route-id="@item.Id">@item</a>
                <a class="btn btn-danger" asp-controller="Home" asp-action="RendezvenyTorles" asp-route-id="@item.Id">x</a>
            </li>
    }
    </ul>
</div>
